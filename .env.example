# Required in production so encrypted round & image tokens survive redeploys.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-64-char-random-hex-secret

# Public origin for SvelteKit CSRF / adapter-node behind Coolify Traefik
ORIGIN=https://episode-guesser.karczma.moe

# Reverse-proxy client IP header for rate limiting:
# - Behind Cloudflare proxy + Coolify Traefik: ADDRESS_HEADER=cf-connecting-ip (and omit XFF_DEPTH)
# - Direct behind Coolify Traefik (1 proxy hop): ADDRESS_HEADER=x-forwarded-for, XFF_DEPTH=1
# - Behind 2 proxies using X-Forwarded-For: ADDRESS_HEADER=x-forwarded-for, XFF_DEPTH=2
ADDRESS_HEADER=cf-connecting-ip

# Listening host/port (defaults match Dockerfile)
HOST=0.0.0.0
PORT=3000
